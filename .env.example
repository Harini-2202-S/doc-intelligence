# Copy to .env and fill in. Never commit .env.
DI_ENVIRONMENT=dev

# SQLite for local use. In deployment, a PostgreSQL URL such as
# postgresql://user:password@host/db?sslmode=require (converted to asyncpg automatically).
DI_DATABASE_URL=sqlite+aiosqlite:///./doc_intelligence.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DI_JWT_SECRET=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DI_STORAGE_ENCRYPTION_KEY=

# File storage: "local" (DI_STORAGE_DIR) or "s3" for S3-compatible object storage such as Cloudflare R2.
DI_STORAGE_BACKEND=local
# DI_S3_BUCKET=
# DI_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# DI_S3_ACCESS_KEY_ID=
# DI_S3_SECRET_ACCESS_KEY=

DI_QUEUE_BACKEND=inline
DI_REDIS_URL=redis://localhost:6379/0

# AI provider. Keep the key out of source control and set a spending limit with the provider.
DI_LLM_PROVIDER=openai
DI_OPENAI_API_KEY=
DI_LLM_MODEL=gpt-4.1-mini
# To run without a key (extractive answers instead of generated ones): DI_LLM_PROVIDER=offline

# RAG
DI_EMBEDDING_MODEL=text-embedding-3-small
# Local vector store folder, or a Qdrant server URL such as https://xxxx.cloud.qdrant.io:6333
DI_QDRANT_LOCATION=./data/qdrant
# DI_QDRANT_API_KEY=
# Optional local cross-encoder reranker: pip install -e ".[rerank]" then set to fastembed
DI_RERANKER=none

# Usage limits for public deployments (0 = unlimited)
# DI_GLOBAL_UPLOADS_PER_HOUR=0
# DI_GLOBAL_CHAT_MESSAGES_PER_HOUR=0
# DI_ALLOW_REGISTRATION=true
